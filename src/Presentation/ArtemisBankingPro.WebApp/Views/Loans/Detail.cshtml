@model ArtemisBankingPro.WebApp.ViewModels.Loans.LoanDetailViewModel
@{
    ViewData["Title"] = "Loan Detail";
}

<h2>Loan @Model.LoanNumber</h2>

<dl class="row">
    <dt class="col-sm-3">Owner</dt>
    <dd class="col-sm-9">@Model.OwnerFullName</dd>
    <dt class="col-sm-3">Amount</dt>
    <dd class="col-sm-9">@Model.Amount.ToString("C")</dd>
    <dt class="col-sm-3">Annual rate</dt>
    <dd class="col-sm-9">@Model.AnnualInterestRate%</dd>
    <dt class="col-sm-3">Term</dt>
    <dd class="col-sm-9">@Model.TermMonths months</dd>
    <dt class="col-sm-3">Monthly payment</dt>
    <dd class="col-sm-9">@Model.MonthlyPayment.ToString("C")</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<a asp-action="EditRate" asp-route-id="@Model.Id" class="btn btn-outline-secondary mb-3">Edit rate</a>

<h4>Amortization schedule</h4>
<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>#</th>
            <th>Due date</th>
            <th>Principal</th>
            <th>Interest</th>
            <th>Total</th>
            <th>Paid</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model.Installments)
        {
            <tr>
                <td>@i.Number</td>
                <td>@i.DueDate.ToString("d")</td>
                <td>@i.PrincipalAmount.ToString("C")</td>
                <td>@i.InterestAmount.ToString("C")</td>
                <td>@i.TotalAmount.ToString("C")</td>
                <td>@i.PaidAmount.ToString("C")</td>
                <td>@i.Status</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-outline-secondary">Back</a>